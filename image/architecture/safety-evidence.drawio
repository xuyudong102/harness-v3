<mxCell id="blocked" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;不满足条件即停止&lt;/b&gt;&lt;br/&gt;未知目标 / 漂移 / 无授权&lt;br/&gt;不得回退或扩大范围&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="40" y="430" width="340" height="120" as="geometry"/></mxCell>
<mxCell id="read" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;只读能力&lt;/b&gt;&lt;br/&gt;只读客户端不提供发布接口&lt;br/&gt;摘要 / 脱敏 / 明确异常&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="480" y="430" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="write" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;受控 Nacos 配置写入&lt;/b&gt;&lt;br/&gt;授权 + 非原子风险确认&lt;br/&gt;Diff / 备份 / 指纹 / 单次发布&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontFamily=Arial;fontSize=17;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="940" y="430" width="300" height="120" as="geometry"/></mxCell>
