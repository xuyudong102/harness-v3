<mxCell id="human" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;ASK_HUMAN / 可恢复等待&lt;/b&gt;&lt;br/&gt;说明缺口、负责人和完成信号&lt;br/&gt;补齐后重新核验，不自动获得授权&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57c00;strokeWidth=1;fontFamily=Arial;fontSize=17;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="40" y="730" width="340" height="120" as="geometry"/></mxCell>
<mxCell id="evidence" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;证据契约（Evidence Contract）&lt;/b&gt;&lt;br/&gt;仓库 / 分支 / HEAD 或 diff&lt;br/&gt;类型 · 结果 · 适用性 · 版本有效性&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontFamily=Arial;fontSize=17;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="480" y="730" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="disclosure" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;配置变更披露&lt;/b&gt;&lt;br/&gt;发布结果、读回结果及备份位置&lt;br/&gt;失败或部分成功也逐项披露&lt;br/&gt;读回不等于加载；重启须另行授权&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontFamily=Arial;fontSize=16;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="940" y="730" width="300" height="120" as="geometry"/></mxCell>
