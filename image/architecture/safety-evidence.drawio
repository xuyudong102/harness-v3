<mxCell id="title" value="安全与证据 · 约束动作，验证事实" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#263238;fontStyle=1;" vertex="1" parent="canvas"><mxGeometry x="40" y="30" width="1200" height="50" as="geometry"/></mxCell>
<mxCell id="sub" value="工具内的安全闭环不等于任务 Workflow；无授权、目标不明或证据不可得时，不伪造成功。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#263238;" vertex="1" parent="canvas"><mxGeometry x="40" y="90" width="1200" height="40" as="geometry"/></mxCell>
<mxCell id="task" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;用户范围与授权&lt;/b&gt;&lt;br/&gt;查询 ≠ 写入；Git push ≠ 部署授权&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1;fontFamily=Arial;fontSize=17;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="40" y="170" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="target" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;目标解析&lt;/b&gt;&lt;br/&gt;Profile：平台 + DEV/SIT&lt;br/&gt;校验地址、命名空间与 Group&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="480" y="170" width="320" height="100" as="geometry"/></mxCell>
<mxCell id="permission" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;真实权限与任务授权&lt;/b&gt;&lt;br/&gt;平台校验账号权限&lt;br/&gt;任务授权不扩展至 PRE/PROD&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="940" y="170" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="relation-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#455a64;fontColor=#455a64;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="canvas" source="task" target="target"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
