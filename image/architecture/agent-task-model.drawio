<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="24.7.8"><diagram id="agent-task-model" name="agent-task-model"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1280" pageHeight="920" background="#ffffff"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="canvas" style="rounded=0;html=1;container=1;pointerEvents=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="920" as="geometry"/></mxCell>
<mxCell id="title" value="Agent 任务运行模型 · 动态选择，而非固定 Phase" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#263238;fontStyle=1;" vertex="1" parent="canvas"><mxGeometry x="40" y="30" width="1200" height="50" as="geometry"/></mxCell>
<mxCell id="sub" value="行动可重排、并行，已有有效证据可复用；必要验收条件与授权要求不可省略。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#263238;" vertex="1" parent="canvas"><mxGeometry x="40" y="90" width="1200" height="40" as="geometry"/></mxCell>
<mxCell id="task" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;任务契约（Task Contract）&lt;/b&gt;&lt;br/&gt;目标 · 范围 · 授权 · 所需证据&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="500" y="150" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="agent" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;Coding Agent&lt;/b&gt;&lt;br/&gt;观察事实，评估行动价值&lt;br/&gt;增益 / 成本 / 风险 / 成功率&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="500" y="350" width="280" height="130" as="geometry"/></mxCell>
<mxCell id="resources" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;按需发现资源&lt;/b&gt;&lt;br/&gt;项目 Rule / Skill / Playbook&lt;br/&gt;只读调查与代码变更契约不同&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="40" y="350" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="helper" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;可调用的工程工具&lt;/b&gt;&lt;br/&gt;Repo / Git / 确定性 Helper&lt;br/&gt;支持编辑或验证，返回真实结果&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="940" y="350" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="human" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;REPLAN / ASK_HUMAN&lt;/b&gt;&lt;br/&gt;外部阻塞或人工更可靠时&lt;br/&gt;说明动作、完成信号和恢复条件&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57c00;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="40" y="620" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="finish" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;证据充分时完成&lt;/b&gt;&lt;br/&gt;结果、风险和未执行项披露&lt;br/&gt;不足则继续选择行动&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="500" y="620" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="facts" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;工具返回证据&lt;/b&gt;&lt;br/&gt;真实结果 / 失败 / 不可用&lt;br/&gt;不能把未知包装为成功&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="940" y="620" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="relation-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#455a64;fontColor=#455a64;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="canvas" source="task" target="agent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
