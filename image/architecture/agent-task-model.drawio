<mxCell id="relation-5" value="反馈" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#455a64;fontColor=#455a64;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="canvas" source="facts" target="agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="675"/><mxPoint x="860" y="540"/><mxPoint x="710" y="540"/></Array></mxGeometry></mxCell>
<mxCell id="relation-6" value="可恢复" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#455a64;fontColor=#455a64;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;startArrow=classic;startFill=1;" edge="1" parent="canvas" source="agent" target="human"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="540"/><mxPoint x="420" y="540"/><mxPoint x="420" y="675"/></Array></mxGeometry></mxCell>
<mxCell id="relation-7" value="按契约判断" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#455a64;fontColor=#455a64;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="canvas" source="agent" target="finish"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="state" value="L0/L1：不要求持久文件。L2+：只保存恢复所需的任务状态与证据；候选行动不是强制下一步。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#263238;" vertex="1" parent="canvas"><mxGeometry x="40" y="770" width="1200" height="40" as="geometry"/></mxCell>
<mxCell id="line-legend" value="实线：调用 / 事实关系    虚线：按需参考    箭头不表示统一任务执行顺序" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#263238;" vertex="1" parent="canvas"><mxGeometry x="40" y="855" width="1200" height="30" as="geometry"/></mxCell>
