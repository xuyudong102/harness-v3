<mxCell id="relation-6" value="反馈" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#455a64;fontColor=#455a64;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="canvas" source="evidence" target="agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="140"/><mxPoint x="140" y="140"/></Array></mxGeometry></mxCell>
<mxCell id="profile" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;Environment Profile&lt;/b&gt;&lt;br/&gt;明确绑定目标，不隐式回退&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;strokeWidth=1;fontFamily=Arial;fontSize=17;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="560" y="330" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="relation-5" value="解析目标" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#455a64;fontColor=#455a64;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="canvas" source="profile" target="helper"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="note" value="Skill 只提供契约，Helper 由 Agent 调用。&#xa;Profile 只解析目标；UNSELECTED 不算 Job 成功。&#xa;通用实现不硬编码目标，失败恢复由 Agent 判断。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#263238;" vertex="1" parent="canvas"><mxGeometry x="880" y="330" width="540" height="90" as="geometry"/></mxCell>
<mxCell id="apifox" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;Apifox OpenAPI Sync&lt;/b&gt;&lt;br/&gt;契约 apifox-openapi-sync；工具 sync-openapi.mjs&lt;br/&gt;按服务计算指纹；仅对变更服务完整导入&lt;br/&gt;轻量读回通过后更新 manifest；不做接口级补丁&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="40" y="490" width="660" height="150" as="geometry"/></mxCell>
<mxCell id="codearts" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;CodeArts Pipeline&lt;/b&gt;&lt;br/&gt;契约 codearts-pipeline；工具 codearts-pipeline.mjs / KooCLI&lt;br/&gt;DEV 构建部署须授权；COMPLETED 仅表示终态&lt;br/&gt;部署核验：Job 实际成功、产物/镜像及 Kubernetes 收敛&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="760" y="490" width="660" height="150" as="geometry"/></mxCell>
<mxCell id="k8s" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;Kubernetes 运行态 · 只读&lt;/b&gt;&lt;br/&gt;契约 runtime-snapshot；工具 kubernetes-read.mjs / kubectl&lt;br/&gt;镜像关联、Deployment/Pod Ready、日志与事件&lt;br/&gt;Helper 不写集群；kubectl 修改须另行明确授权&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="40" y="710" width="660" height="150" as="geometry"/></mxCell>
<mxCell id="read" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;Nacos Read&lt;/b&gt;&lt;br/&gt;契约 nacos-read；工具 nacos-read.mjs / nacos-client.mjs&lt;br/&gt;只读查询健康、配置与服务；本地差异统计&lt;br/&gt;摘要脱敏；请求、超时与输出大小均有上限&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="760" y="710" width="660" height="150" as="geometry"/></mxCell>
<mxCell id="write" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;Nacos 受控配置写入 · DEV/SIT&lt;/b&gt;&lt;br/&gt;契约 nacos-config-write；工具 nacos-config-write.mjs&lt;br/&gt;CREATE / UPDATE / APPEND；不提供 DELETE&lt;br/&gt;授权与非原子风险确认；备份、读回、逐项披露&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="40" y="930" width="660" height="150" as="geometry"/></mxCell>
<mxCell id="env" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;Environment Profile / 目标解析&lt;/b&gt;&lt;br/&gt;environment-profile.mjs · 共享本机目标解析&lt;br/&gt;按平台与 DEV/SIT 绑定；不同系统的命名空间分开&lt;br/&gt;目标缺失或漂移即停止；凭据仅引用&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="760" y="930" width="660" height="150" as="geometry"/></mxCell>
