<mxCell id="title" value="工程能力 · 工具机械执行，Agent 决策" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#263238;fontStyle=1;" vertex="1" parent="canvas"><mxGeometry x="40" y="30" width="1380" height="50" as="geometry"/></mxCell>
<mxCell id="sub" value="Agent 按需读取 Skill 契约并调用 Helper；工具返回紧凑证据，不构建跨系统 Workflow。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#263238;" vertex="1" parent="canvas"><mxGeometry x="40" y="90" width="1380" height="40" as="geometry"/></mxCell>
<mxCell id="agent" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;Coding Agent&lt;/b&gt;&lt;br/&gt;依任务选择行动&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="40" y="160" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="skill" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;规范 Skill&lt;/b&gt;&lt;br/&gt;供 Agent 按需读取，不执行工具&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="40" y="330" width="460" height="90" as="geometry"/></mxCell>
<mxCell id="helper" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;确定性 Helper&lt;/b&gt;&lt;br/&gt;有界调用 / 紧凑输出&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="560" y="160" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="external" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;外部工程系统&lt;/b&gt;&lt;br/&gt;权威事实与真实权限&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="880" y="160" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="evidence" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b&gt;证据反馈&lt;/b&gt;&lt;br/&gt;结果 / 缺口 / 风险&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#263238;spacing=14;" vertex="1" parent="canvas"><mxGeometry x="1180" y="160" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="relation-1" value="按需读取" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#455a64;fontColor=#455a64;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.10869565217391304;entryY=0;dashed=1;entryDx=0;entryDy=0;" edge="1" parent="canvas" source="agent" target="skill"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="relation-2" value="调用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#455a64;fontColor=#455a64;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="canvas" source="agent" target="helper"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="relation-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#455a64;fontColor=#455a64;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="canvas" source="helper" target="external"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
